# Setu Moolya Frontend — Environment Variables
# Copy this file to .env.local and update the values

# Backend API URL (Express server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Required only when backend SMS_PROVIDER=msg91.
# Use the MSG91 widget ID and widget-specific tokenAuth from the MSG91 dashboard.
# Never put the backend MSG91_AUTH_KEY here.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=
